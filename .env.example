# ============================================================
# docker compose 环境变量模板（仓库根目录）
# ============================================================
#
# 用法：
#   1. 复制本文件为 `.env`（**已被 .gitignore 忽略**，不会进版本库）：
#        cp .env.example .env
#   2. 把下面的占位值替换为强随机值，再执行 `docker compose up -d`。
#
# ⚠️ 这是**仓库根目录**的 .env，只服务于根目录的 `docker-compose.yml`。
#    `backend/docker-compose-base.yml` 在 `backend/` 下执行，读的是 `backend/.env`，
#    而后端应用也读 `backend/.env`。**两处同名的口令必须保持一致**，
#    否则容器里的库与应用连的不是同一套凭据。
#
# ⚠️ 轮换口令不会影响已初始化的数据卷 —— Postgres / MinIO 只在**首次初始化**时
#    读取这些变量。若你的卷是用旧口令建的，改本文件后需要二选一：
#      a) 把下面几项改回旧口令（最省事，旧卷继续可用）；
#      b) 在容器内改口令（`ALTER USER postgres PASSWORD '<新口令>';` /
#         `mc admin user add` 等），或 `docker compose down -v` 重建卷（**会丢数据**）。

# ---------- PostgreSQL ----------
# 生成方式: python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=

# ---------- MinIO（Milvus 的对象存储后端） ----------
# ⚠️ 这两项必须同时设置：Milvus 会用同一组凭据读写 MinIO
#    （已通过 MINIO_ACCESS_KEY_ID / MINIO_SECRET_ACCESS_KEY 透传）。
#    任一项为空会导致 Milvus 连不上 MinIO，向量库静默不可写。
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

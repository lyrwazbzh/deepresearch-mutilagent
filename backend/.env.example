# ==================== LLM & Embedding ====================
# 阿里云百炼 API Key（必填）
# 申请地址: https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=your-dashscope-api-key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_MODEL=qwen3-max

# ==================== OpenRouter API ====================
# OpenRouter API Key（可选，用于多模型支持）
# 申请地址: https://openrouter.ai/
OPENROUTER_API_KEY=your-openrouter-api-key

# ==================== 文档解析 (DocMind) ====================
# 阿里云 DocMind 文档解析服务（可选）
# 申请地址: https://help.aliyun.com/zh/ram/user-guide/create-an-accesskey-pair
DOCMIND_ACCESS_KEY_ID=your-access-key-id
DOCMIND_ACCESS_KEY_SECRET=your-access-key-secret

# ==================== 搜索 API ====================
# 博查搜索 API（必填）
# 申请地址: https://open.bochaai.com/
# ⚠️ 只填裸密钥，不要带 "Bearer " 前缀 —— 前缀由代码拼接（dr_g.py / scout.py / news_collection_service.py）。
BOCHA_API_KEY=your-bocha-api-key

# Serper 搜索 API（可选）
SERPER_API_KEY=your-serper-api-key

# ==================== RAGFlow 文档服务（可选，方案 B）====================
# 仅 document_router / document_service 使用；主力知识库走本地 Milvus，不需要这些。
# ⚠️ 这三项历史上曾带有真实凭据作为默认值，现改为必填，未配置时相关接口会显式报错。
API_BASE_URL=http://localhost:9380
API_KEY=your-ragflow-api-key
DEFAULT_DATASET_ID=your-ragflow-dataset-id

# ==================== 行业资讯 API ====================
# 聚合数据 - 股票行情 API（可选）
# 申请地址: https://www.juhe.cn/docs/api/id/21
JUHE_STOCK_API_KEY=your-juhe-stock-api-key

# ==================== 招投标 API ====================
# 阿里云市场 - 招投标信息 API（可选）
# 申请地址: https://market.aliyun.com/detail/cmapi00063550
BID_APP_KEY=your-bid-app-key
BID_APP_SECRET=your-bid-app-secret
BID_APP_CODE=your-bid-app-code

# ==================== Redis ====================
# Docker 默认配置，通常无需修改
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ==================== PostgreSQL ====================
# ⚠️ POSTGRES_PASSWORD 自 T07 起【必填】：留空或缺失会让后端在【启动阶段】直接报错退出
#    （与 JWT_SECRET_KEY 同一风格）。历史上这里给的是公开可知的弱口令（postgres + 数字后缀），已移除。
#    生成方式: python -c "import secrets; print(secrets.token_urlsafe(24))"
#    注意：必须与仓库根目录 .env 里的同名变量保持一致，否则容器里的库与应用连的不是一套凭据。
#    另：轮换口令只影响**首次初始化**的卷；旧卷仍用旧口令，需 `ALTER USER` 或重建卷（会丢数据）。
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=industry_assistant

# ==================== PostgreSQL 只读账号（T10） ====================
# text2sql 专用连接串。配置后 text2sql 走只有 SELECT 权限的角色 —— 即使 SQL 解析式校验被
# 绕过，写操作也会在【数据库层】被拒绝（唯一根治手段，见 tickets.md T10）。
# 留空则回退主库（POSTGRES_*），此时只有解析式防线。
# 建号示例（在目标库中执行，口令请用 python -c "import secrets; print(secrets.token_urlsafe(24))")：
#   CREATE ROLE text2sql_ro LOGIN PASSWORD '<强随机>';
#   GRANT CONNECT ON DATABASE <db> TO text2sql_ro;
#   GRANT USAGE   ON SCHEMA public TO text2sql_ro;
#   GRANT SELECT  ON ALL TABLES IN SCHEMA public TO text2sql_ro;
#   ALTER DEFAULT PRIVILEGES IN SCHEMA public GRANT SELECT ON TABLES TO text2sql_ro;
# 格式：postgresql://text2sql_ro:<口令>@localhost:5432/industry_assistant
TEXT2SQL_DATABASE_URL=

# ==================== MinIO（Milvus 的对象存储后端） ====================
# 供 `backend/docker-compose-base.yml` 使用（该文件在 backend/ 目录下执行，读本文件同目录的 .env）。
# ⚠️ 两项必须同时设置且与根目录 .env 保持一致：Milvus 会用同一组凭据读写 MinIO。
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# ==================== Milvus ====================
# Docker 默认配置，通常无需修改
MILVUS_HOST=localhost
MILVUS_PORT=19530

# ==================== JWT 认证 ====================
# ⚠️ 必填，且长度必须 ≥ 32 字符。留空、过短、或直接沿用本文件的示例值，
#    都会导致后端在【启动阶段】直接报错退出（这是有意的：公开已知的密钥可被用来伪造 Token）。
# 生成方式: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ==================== CORS ====================
# 跨域来源白名单，逗号分隔（不要带结尾斜杠）。例:
#   CORS_ALLOW_ORIGINS=http://localhost:5183,https://your-domain.com
# 留空时：非生产环境退回 `*` 并强制 allow_credentials=False（本地调试用）；
#        生产环境（ENV=production）留空会【启动失败】，避免静默放开任意来源。
# 注意：来源含 `*` 时【一律禁用凭据】（浏览器规范禁止二者并存）；
#       来源为具体地址时 allow_credentials=True（可按需带 Cookie）。
# 本项目登录态走 Authorization: Bearer 头，不依赖 Cookie，故禁用凭据不影响前端调用。
CORS_ALLOW_ORIGINS=

# ==================== 其他配置 ====================
# 数据库建表：默认不执行 create_all（建表以 backend/migrations/ 的手写迁移 SQL 为准）。
# 仅本地开发想跳过迁移、由 ORM 自动建表时才设为 1。
DB_AUTO_CREATE=
MEM_LIMIT=8073741824
TIMEZONE=Asia/Shanghai

# ==================== Observability ====================
ENV=development
APP_RELEASE=local
LOG_LEVEL=INFO
JSON_LOG_FILE=logs/application.jsonl
OBSERVABILITY_TRACING_ENABLED=true
OBSERVABILITY_CAPTURE_CONTENT=false
OTEL_TRACE_SAMPLE_RATE=1.0
LANGFUSE_BASE_URL=http://localhost:3000
LANGFUSE_PUBLIC_KEY=replace-with-project-public-key
LANGFUSE_SECRET_KEY=replace-with-project-secret-key
LANGFUSE_TIMEOUT_SECONDS=5
# 兼容独立 LangFuse 客户端；新可观测性链路以 OBSERVABILITY_TRACING_ENABLED 为主。
LANGFUSE_ENABLED=false

# ==================== Hybrid Retrieval & QLoRA Router ====================
ELASTICSEARCH_URL=http://localhost:9200
TOOL_ROUTER_ENABLED=0
TOOL_ROUTER_BASE_URL=http://tool-router:8080
TOOL_ROUTER_API_TOKEN=
TOOL_ROUTER_TIMEOUT_SECONDS=5
# 以 session_id 稳定哈希分桶；0=全量规则路由，100=全量 Adapter。
TOOL_ROUTER_GRAY_PERCENT=0
TOOL_ROUTER_MIN_CONFIDENCE=0.65
# 仅允许服务端预配置只读连接，JSON: {"profile-id":"postgresql://..."}
TEXT2SQL_DATABASE_PROFILES={}
# LLM 降级链，条目只引用密钥环境变量名，不在 JSON 中保存真实密钥。
LLM_FALLBACK_CHAIN=[]
RESEARCH_TIMEOUT_SECONDS=1800
LLM_TIMEOUT_SECONDS=90
LLM_MAX_ATTEMPTS=3
TOOL_TIMEOUT_SECONDS=30
TOOL_MAX_ATTEMPTS=3
MEMORY_TIMEOUT_SECONDS=10

# ==================== Research Memory Lifecycle ====================
# 周期性依据时效、访问频率和置信度计算记忆热度；低热度迁入冷层，
# 冷层记忆在检索相关度达到阈值时自动恢复并重新计入访问统计。
MEMORY_TIERING_INTERVAL_MINUTES=360
MEMORY_TIERING_BATCH_SIZE=1000
MEMORY_RECENCY_HALF_LIFE_DAYS=90
MEMORY_FREQUENCY_SATURATION=8
MEMORY_MINIMUM_HOT_DAYS=30
MEMORY_COLD_THRESHOLD=0.35
MEMORY_REHYDRATE_RELEVANCE_THRESHOLD=0.55
